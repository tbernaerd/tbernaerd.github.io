---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getAllPosts, taxonomySlug, taxonomyValues } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getAllPosts();
  return taxonomyValues(posts, 'categories').map((value) => ({
    params: { slug: taxonomySlug(value) },
    props: {
      value,
      posts: posts.filter((post) => post.data.categories.includes(value)),
    },
  }));
}
const { value, posts } = Astro.props;
---

<BaseLayout
  title={`${value} articles`}
  description={`Articles about ${value} by Tom Bernaerd.`}
>
  <section class="wrap section taxonomy">
    <a class="text-link" href="/categories/">
      ← All categories
    </a>
    <p class="section-note">From the notes</p>
    <h1>{value}.</h1>
    <p class="intro">
      {posts.length} {posts.length === 1 ? 'article' : 'articles'}
    </p>
    <ArticleList posts={posts} />
  </section>
</BaseLayout>
<style>
  .taxonomy {
    max-width: 1080px;
  }
  .taxonomy > .section-note {
    margin-top: 3rem;
  }
  .taxonomy h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    letter-spacing: -0.06em;
    line-height: 1.12;
    margin: 1rem 0;
  }
  .intro {
    color: #516678;
    margin: 1rem 0 3rem;
  }
</style>
