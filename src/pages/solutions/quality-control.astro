---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QualityIllustration from '../../components/QualityIllustration.astro';
import Icon from '../../components/Icon.astro';
import CTA from '../../components/CTA.astro';
---

<BaseLayout
  title="Quality control & batch release"
  description="Connect samples, test results, certificates and accepted-batch release to SAP Business One and Produmex WMS. Explore a QC workflow built around your operation."
>
  <section class="section">
    <div class="wrap feature-grid product-hero">
      <div class="feature-copy">
        <p class="section-note">OuterForge Quality</p>
        <h1>
          From the lab
          <br />
          to released stock.
        </h1>
        <p>
          Samples, results and batch decisions in one web application. Connected
          to the SAP and Produmex records behind them.
        </p>
        <div class="actions">
          <a class="button" href="/contact/?interest=quality">
            Discuss your QC workflow <Icon />
          </a>
        </div>
      </div>
      <div class="feature-bg">
        <QualityIllustration />
      </div>
    </div>
  </section>
  <section class="section service-area">
    <div class="wrap">
      <div class="section-head">
        <h2>
          Keep the quality evidence
          <br />
          with the batch.
        </h2>
        <p>
          A connected workflow for the lab, the people reviewing results and the
          warehouse waiting for a decision.
        </p>
      </div>
      <div class="service-list">
        <article class="service">
          <h3>Capture the results.</h3>
          <p>
            Keep samples and test results together, with the batch context
            needed to understand what was tested.
          </p>
        </article>
        <article class="service">
          <h3>Review with context.</h3>
          <p>
            Bring the results and certificates into one place so the people
            making a quality decision can find the evidence.
          </p>
        </article>
        <article class="service">
          <h3>Connect the release.</h3>
          <p>
            Connect accepted-batch decisions to Produmex stock release, with the
            handoff scoped to your warehouse workflow.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section studio-section">
    <div class="wrap editorial-split">
      <h2>
        Your quality process.
        <br />
        Your connected workflow.
      </h2>
      <div class="prose">
        <p>
          The application is shaped around your tests, records and handoffs. We
          start by looking at the process you use today and where it needs to
          connect to SAP Business One and Produmex WMS.
        </p>
        <p>
          We then agree the scope of configuration, any additional development,
          deployment and support. A walkthrough is the next step in assessing
          the fit.
        </p>
        <p>
          <a class="text-link" href="/contact/?interest=quality-demo">
            Arrange a walkthrough <Icon />
          </a>
        </p>
      </div>
    </div>
  </section>
  <CTA />
</BaseLayout>
