---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QualityIllustration from '../../components/QualityIllustration.astro';
import CertificateReview from '../../components/CertificateReview.astro';
import QualityWorkflow from '../../components/QualityWorkflow.astro';
import LabReportPreview from '../../components/LabReportPreview.astro';
import Icon from '../../components/Icon.astro';
const features = [
  {
    title: 'Define what needs testing.',
    text: 'Set up item and category templates with test methods, units, limits and qualitative expectations. Define test frequency, internal or external sources and which parameters are required for release.',
  },
  {
    title: 'Keep track of every sample.',
    text: 'Link samples to batches, print labels and use scanning in the sample workflow. Record quantities, storage and disposal, with the test record carrying its own copy of the specifications.',
  },
  {
    title: 'Work with external labs.',
    text: 'Create analysis requests, select the required tests and send the request by email with a generated PDF. Keep the lab report and returned results with the request.',
  },
  {
    title: 'Review results with the evidence.',
    text: 'Evaluate results against specification limits. Route exceptions and review-required records to QC review, with attributed decisions and support for acceptance under deviation.',
  },
  {
    title: 'Release stock through Produmex.',
    text: 'An accepted QC record can trigger a stock-quality update through the Produmex API. Track whether the release succeeded, including failures that need attention.',
  },
  {
    title: 'Produce your own CoAs.',
    text: 'Generate Certificates of Analysis from accepted test records. Configure which specifications, results, methods and sources appear, and keep the resulting PDF with the record.',
  },
];
---

<BaseLayout
  title="OuterForge Quality: QC & batch release"
  description="Ready-made QC software built on OuterForge. Specifications, samples, AI supplier CoA checks, external lab results and batch release, connected to SAP Business One and Produmex WMS."
>
  <section class="section quality-hero">
    <div class="wrap feature-grid product-hero">
      <div class="feature-copy">
        <p class="section-note">OuterForge Quality</p>
        <h1>
          From the lab
          <br />
          to released stock.
        </h1>
        <p>
          Ready-made quality-control and batch-release software, built on the{' '}
          <a class="inline-platform" href="/outerforge/">
            OuterForge web-based application platform
          </a>
          .
        </p>
        <p>
          Manage specifications, samples, test results and supplier certificates
          in one application, connected to SAP Business One and Produmex WMS.
          Configure it for your operation and extend it where needed.
        </p>
        <div class="actions">
          <a class="button" href="/contact/?interest=quality-demo">
            Arrange a demo <Icon />
          </a>
          <a class="text-link" href="#document-review">
            See the AI document check <Icon />
          </a>
        </div>
      </div>
      <div class="feature-bg">
        <QualityIllustration id="quality-product" />
      </div>
    </div>
  </section>
  <section class="section studio-section" id="document-review">
    <div class="wrap">
      <div class="section-head">
        <h2>
          Check the certificate
          <br />
          against your specification.
        </h2>
        <p>
          AI-assisted supplier document review is built into Quality. Start a
          check on an attached Certificate of Analysis and keep the findings
          with its test record.
        </p>
      </div>
      <CertificateReview />
      <div class="review-explanation">
        <p>
          <strong>Spot the differences.</strong> Compare specification limits
          and methods, identify missing parameters and flag uncertain readings.
          Check batch references, product identity, dates and authorization
          details.
        </p>
        <p>
          <strong>Keep the decision with QC.</strong> The check produces
          findings for review. It does not change test results or release stock.
          Other documents in a combined PDF are identified; the comparison
          focuses on the supplier CoA.
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap feature-grid">
      <div class="feature-copy">
        <h2>
          Bring lab results in.
          <br />
          Keep the analyst in control.
        </h2>
        <p>
          Upload an external lab report as a PDF or image. AI extracts proposed
          measured results and matches them to the requested tests, highlighting
          uncertain readings and unit mismatches.
        </p>
        <p>
          Review the suggestions, accept or correct them, then save. This is a
          separate workflow from the supplier CoA specification check.
        </p>
      </div>
      <LabReportPreview />
    </div>
  </section>
  <section class="section service-area">
    <div class="wrap">
      <div class="section-head">
        <h2>
          The everyday QC work,
          <br />
          already covered.
        </h2>
        <p>
          Existing application features, configured around your items, tests and
          review process.
        </p>
      </div>
      <div class="service-list quality-features">
        {features.map(({ title, text }) => (
          <article class="service">
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section studio-section">
    <div class="wrap">
      <div class="section-head">
        <h2>
          Follow the batch
          <br />
          through the decision.
        </h2>
        <p>
          The lab, reviewers and warehouse use connected records throughout
          testing, QC review and acceptance.
        </p>
      </div>
      <QualityWorkflow />
    </div>
  </section>
  <section class="section">
    <div class="wrap editorial-split">
      <h2>
        Ready-made software.
        <br />
        Configured for your operation.
      </h2>
      <div class="prose">
        <p>
          We start with a walkthrough of the existing Quality application.
          Together, we check your specifications, sample handling, review rules
          and SAP/Produmex environment.
        </p>
        <p>
          Delivery covers installation, connections, permissions and
          configuration. Where your operation needs additional functionality, we
          scope that development on the same OuterForge platform.
        </p>
        <p>
          Users, email, background processing and audit history come from
          OuterForge. The quality-control workflow is already built on top.
        </p>
        <p>
          <a class="text-link" href="/outerforge/">
            Explore the platform behind Quality <Icon />
          </a>
        </p>
      </div>
    </div>
  </section>
  <section class="closing">
    <div class="wrap">
      <div>
        <h2>
          Walk through Quality
          <br />
          with your process in mind.
        </h2>
        <p>
          See the application and discuss the fit for your lab, review process
          and warehouse.
        </p>
      </div>
      <a class="button" href="/contact/?interest=quality-demo">
        Arrange a demo <Icon />
      </a>
    </div>
  </section>
</BaseLayout>
<style>
  .quality-hero {
    padding-top: 75px;
  }
  .quality-hero .section-note {
    margin-top: 0;
  }
  .inline-platform {
    color: var(--blue);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .quality-hero .actions {
    gap: 20px;
  }
  .quality-hero .actions .text-link {
    margin-top: 0;
    font-size: 16px;
  }
  .review-explanation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    margin-top: 30px;
    font-size: 16px;
  }
  .review-explanation strong {
    color: var(--ink);
  }
  .quality-features {
    gap: 45px;
  }
  @media (max-width: 800px) {
    .review-explanation {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .quality-hero {
      padding-top: 45px;
    }
  }
</style>
