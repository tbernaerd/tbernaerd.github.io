---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="SAP & Produmex consulting"
  description="Hands-on SAP Business One and Produmex WMS consulting. Technical troubleshooting, workflow advice and focused improvements with Tom Bernaerd."
>
  <PageIntro
    label="SAP & Produmex consulting"
    title="Experience you can put to work."
    description="A technical issue to untangle. A workflow to improve. An integration decision to get right. Get hands-on help from someone who understands the systems and the operation."
  >
    <div class="actions">
      <a class="button" href="/contact/?interest=consulting">
        Discuss a consulting need <Icon />
      </a>
    </div>
  </PageIntro>
  <section class="section service-area">
    <div class="wrap">
      <div class="section-head">
        <h2>
          Practical help.
          <br />A clear scope.
        </h2>
        <p>
          Work directly with Tom on the questions, issues and improvements that
          need specialist attention.
        </p>
      </div>
      <div class="service-list">
        <article class="service">
          <div class="service-icon">
            <Icon name="consult" />
          </div>
          <h3>Technical troubleshooting.</h3>
          <p>
            Investigate unexpected SAP and Produmex behavior, trace the cause
            and work through a practical resolution.
          </p>
        </article>
        <article class="service">
          <div class="service-icon">
            <Icon name="link" />
          </div>
          <h3>Workflow and integration advice.</h3>
          <p>
            Review how a process fits the system, understand the dependencies
            and decide where configuration, customization or an integrated
            application can help.
          </p>
        </article>
        <article class="service">
          <div class="service-icon">
            <Icon name="code" />
          </div>
          <h3>Focused improvements.</h3>
          <p>
            Scope and deliver targeted changes to existing workflows and
            integrations, with attention to the people using them.
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section studio-section">
    <div class="wrap editorial-split">
      <h2>
        Start with the issue.
        <br />
        Agree the next step.
      </h2>
      <div class="prose">
        <p>
          Bring the process, the symptoms or the decision you’re facing. We’ll
          establish the context, agree what needs investigating and define a
          useful scope.
        </p>
        <p>
          Consulting can be a focused engagement in its own right, or accompany
          the development of an application. Scope, availability and fees are
          agreed before work starts.
        </p>
        <p>
          <a class="text-link" href="/contact/?interest=consulting">
            Talk to Tom <Icon />
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
