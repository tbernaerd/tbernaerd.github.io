---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ArticleThumbnail from '../components/ArticleThumbnail.astro';
import ConnectionScene from '../components/ConnectionScene.astro';
import QualityIllustration from '../components/QualityIllustration.astro';
import Services from '../components/Services.astro';
import Studio from '../components/Studio.astro';
import CTA from '../components/CTA.astro';
import { getListedPosts, postUrl } from '../lib/posts';
const posts = (await getListedPosts()).slice(0, 3);
---

<BaseLayout>
  <section class="hero-a wrap">
    <div>
      <div class="section-note">
        Independent software studio
        <span class="tiny-dot" aria-hidden="true"></span>
        Logistics consulting
      </div>
      <h1>
        The missing piece
        <br />
        in your business
        <br />
        software.
      </h1>
      <p class="intro">
        Quality-control software, bespoke web applications and logistics
        consulting. Connected to SAP Business One and Produmex WMS, with
        hands-on knowledge of the systems you run.
      </p>
      <div class="actions">
        <a class="button" href="/contact/">
          Discuss your workflow <Icon />
        </a>
        <a class="text-link" href="/outerforge/">
          Meet OuterForge <Icon />
        </a>
      </div>
      <p class="understatement">
        SAP Business One · Produmex WMS · Connected applications
      </p>
    </div>
    <ConnectionScene />
  </section>
  <div class="expertise-strip">
    <div class="wrap expertise-inner">
      <p>Built on experience with the systems you rely on.</p>
      <div class="expertise-items">
        <span>SAP Business One</span>
        <span>Produmex WMS</span>
        <span>Bespoke development</span>
      </div>
    </div>
  </div>
  <section class="section">
    <div class="wrap feature-grid">
      <div class="feature-copy">
        <div class="section-note">
          OuterForge Quality · Ready-made QC software
        </div>
        <h2>
          From the lab
          <br />
          to released stock.
        </h2>
        <p>
          OuterForge Quality is the QC and batch-release application built on
          our OuterForge platform. Specifications, samples and supplier
          certificates stay with the batch, from testing through PMX stock
          release.
        </p>
        <ul>
          <li>
            <Icon name="check" /> Specifications, samples and internal or
            external tests
          </li>
          <li>
            <Icon name="check" /> AI-Assisted checks on supplier provenance
            documentation (e.g. Certificate of Analysis)
          </li>
          <li>
            <Icon name="check" /> Batch QC acceptance triggers quality status
            change in Produmex WMS
          </li>
        </ul>
        <a class="text-link" href="/solutions/quality-control/">
          Explore OuterForge Quality <Icon />
        </a>
      </div>
      <div class="feature-bg">
        <QualityIllustration />
      </div>
    </div>
  </section>
  <section class="section service-area">
    <div class="wrap">
      <div class="section-head">
        <h2>Software and consulting.</h2>
        <p>
          Start with an existing Quality application, commission a bespoke
          application, or get focused help with SAP and Produmex.
        </p>
      </div>
      <Services />
      <div class="platform-context">
        <Icon name="layers" />
        <p>
          <strong>One platform behind the applications.</strong> OuterForge
          provides the SAP and Produmex connections, user management, email and
          background jobs shared by Quality and the applications we build for
          you.
        </p>
        <a class="text-link" href="/outerforge/">
          Explore the platform <Icon />
        </a>
      </div>
    </div>
  </section>
  <Studio />
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>From the workbench.</h2>
        <p>
          Practical notes on business software,
          <br />
          integrations and building things that work.
        </p>
      </div>
      <div class="article-list">
        {posts.map((post) => (
          <article class="article article-with-image">
            <a href={postUrl(post)}>
              <ArticleThumbnail post={post} />
              <small>{post.data.categories.join(' / ')}</small>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="read">
                Read the note <Icon />
              </span>
            </a>
          </article>
        ))}
      </div>
      <a class="text-link insights-link" href="/insights/">
        All insights <Icon />
      </a>
    </div>
  </section>
  <CTA />
</BaseLayout>

<style>
  .platform-context {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    border-top: 1px solid var(--line);
    padding-top: 32px;
    margin-top: 48px;
  }
  .platform-context > :global(.icon) {
    color: var(--blue);
    margin-top: 5px;
  }
  .platform-context p {
    flex: 1;
    max-width: 740px;
  }
  .platform-context strong {
    color: var(--ink);
  }
  .platform-context a {
    flex-shrink: 0;
    font-size: 16px;
  }
  @media (max-width: 800px) {
    .platform-context {
      flex-wrap: wrap;
    }
    .platform-context p {
      flex-basis: calc(100% - 50px);
    }
    .platform-context a {
      margin-left: 41px;
    }
  }
</style>
