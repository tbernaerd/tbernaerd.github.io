---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Let’s talk"
  description="Talk to Tom about a bespoke application, connected quality control or an SAP Business One and Produmex integration."
>
  <section class="page-intro wrap contact-intro">
    <p class="section-note">Let’s talk</p>
    <h1>
      What’s missing from
      <br />
      your business software?
    </h1>
    <p class="page-lead">
      Tell me where the process gets awkward, what you use today, and what a
      better way of working would look like.
    </p>
    <div class="actions">
      <a
        class="button"
        data-email-action
        href="mailto:tom@outerjoin.be?subject=Let%27s%20discuss%20a%20workflow"
      >
        Email Tom <Icon />
      </a>
      <a
        class="text-link"
        href="https://www.linkedin.com/in/tbernaerd"
        target="_blank"
        rel="noopener noreferrer"
      >
        Connect on LinkedIn <Icon />
      </a>
    </div>
    <p class="contact-email">
      <a href="mailto:tom@outerjoin.be">tom@outerjoin.be</a>
    </p>
  </section>
  <section class="section studio-section">
    <div class="wrap contact-grid">
      <div class="contact-details">
        <div class="contact-person">
          <img
            src="/tom-bernaerd.jpg"
            alt="Tom Bernaerd"
            width="110"
            height="110"
          />
          <div>
            <h2>Tom Bernaerd</h2>
            <p>Outer Join BV</p>
          </div>
        </div>
        <address>
          <p>
            Snellegemsestraat 90
            <br />
            8210 Zedelgem
            <br />
            Belgium
          </p>
          <p>VAT: BE0768.928.995</p>
          <p>
            <a href="mailto:tom@outerjoin.be">tom@outerjoin.be</a>
            <br />
            <a href="tel:+32477466814">+32 477 466 814</a>
          </p>
        </address>
      </div>
      <div class="prose">
        <h2>A useful first conversation.</h2>
        <p>
          We’ll look at the workflow, the systems involved and where an
          application could help. From there, we can agree whether a walkthrough
          or a scoped discovery is the right next step.
        </p>
        <p>
          You can start with a simple description. A specification can come
          later.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-details address {
    margin-top: 28px;
    font-style: normal;
    font-size: 18px;
    line-height: 1.7;
    color: var(--slate);
  }
  .contact-details address p + p {
    margin-top: 16px;
  }
  .contact-details address a {
    text-underline-offset: 4px;
  }
</style>

<script>
  const subjects: Record<string, string> = {
    consulting: 'Let’s discuss SAP and Produmex consulting',
    quality: 'Let’s discuss a QC workflow',
    'quality-demo': 'OuterForge Quality walkthrough',
    integration: 'Let’s discuss an integration',
    outerforge: 'Let’s discuss an OuterForge application',
  };
  const interest = new URLSearchParams(location.search).get('interest');
  const email = document.querySelector<HTMLAnchorElement>(
    '[data-email-action]',
  );
  if (interest && Object.hasOwn(subjects, interest) && email) {
    email.href = `mailto:tom@outerjoin.be?subject=${encodeURIComponent(subjects[interest])}`;
  }
</script>
