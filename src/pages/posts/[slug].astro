---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleImage from '../../components/ArticleImage.astro';
import {
  getAllPosts,
  postUrl,
  formatDate,
  readingMinutes,
  taxonomySlug,
} from '../../lib/posts';
export async function getStaticPaths() {
  return (await getAllPosts()).map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published.toISOString(),
  dateModified: post.data.updated.toISOString(),
  url: `https://outerjoin.be${postUrl(post)}`,
  mainEntityOfPage: `https://outerjoin.be${postUrl(post)}`,
  author: {
    '@type': 'Person',
    name: 'Tom Bernaerd',
    url: 'https://outerjoin.be/about/',
  },
  ...(post.data.image
    ? { image: `https://outerjoin.be${post.data.image.src}` }
    : {}),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image?.src}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    ></script>
    <meta property="og:type" content="article" />
    <meta
      property="article:published_time"
      content={post.data.published.toISOString()}
    />
    <meta
      property="article:modified_time"
      content={post.data.updated.toISOString()}
    />
  </Fragment>
  <article class="wrap section article-shell">
    <header class="article-header">
      <a class="text-link" href="/insights/">
        ← Insights
      </a>
      <p class="section-note">{post.data.categories.join(' / ')}</p>
      <h1>{post.data.title}</h1>
      <p class="standfirst">{post.data.description}</p>
      <div class="byline">
        <span>Tom Bernaerd</span>
        <time datetime={post.data.published.toISOString()}>
          {formatDate(post.data.published)}
        </time>
        <span>{readingMinutes(post)} min read</span>
      </div>
      {post.data.updated.valueOf() !== post.data.published.valueOf() && (
        <p class="updated">
          Updated{' '}
          <time datetime={post.data.updated.toISOString()}>
            {formatDate(post.data.updated)}
          </time>
        </p>
      )}
    </header>
    {post.data.image && (
      <div class="article-hero">
        <ArticleImage image={post.data.image} />
      </div>
    )}
    <div class="article-grid">
      <aside class="contents">
        <details open>
          <summary>In this article</summary>
          <nav aria-label="Table of contents">
            <ol>
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      </aside>
      <div class="article-body">
        <Content />
        <footer class="article-end">
          <p class="section-note">Filed under</p>
          <div class="tags">
            {post.data.tags.map((tag) => (
              <a href={`/tags/${taxonomySlug(tag)}/`}>{tag}</a>
            ))}
          </div>
          <p>
            Something to discuss? <a href="/contact/">Get in touch.</a>
          </p>
          <a class="text-link" href="/insights/">
            ← More insights
          </a>
        </footer>
      </div>
    </div>
  </article>
</BaseLayout>
<style>
  .article-shell {
    max-width: 1240px;
    padding-inline: clamp(24px, 4vw, 54px);
  }
  .article-header {
    max-width: 870px;
    padding-bottom: 2.6rem;
  }
  .article-header > .section-note {
    margin-top: 2.7rem;
  }
  .article-header h1 {
    font-size: clamp(2.3rem, 4.7vw, 4.3rem);
    line-height: 1.14;
    letter-spacing: -0.055em;
    margin: 1rem 0 1.5rem;
  }
  .standfirst {
    max-width: 760px;
    font-size: 1.25rem;
    color: var(--slate);
    line-height: 1.6;
  }
  .byline {
    display: flex;
    gap: 0.5rem 1.3rem;
    flex-wrap: wrap;
    margin-top: 1.7rem;
    font-size: 0.95rem;
    color: var(--slate);
  }
  .byline span:first-child {
    font-weight: 600;
    color: var(--ink);
  }
  .updated {
    font-size: 0.85rem;
    color: var(--slate);
    margin: 0.4rem 0 0;
  }
  .article-hero {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 6px;
    margin-bottom: 3.5rem;
  }
  .article-grid {
    display: grid;
    grid-template-columns: 220px minmax(0, 720px);
    gap: 4rem;
    align-items: start;
  }
  .contents {
    position: sticky;
    top: 110px;
    font-size: 0.84rem;
    max-height: calc(100vh - 130px);
    overflow: auto;
    padding-right: 1rem;
  }
  .contents summary {
    font-weight: 600;
    margin-bottom: 1rem;
    cursor: pointer;
  }
  .contents ol {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--line);
  }
  .contents li {
    margin: 0.75rem 0;
    padding-left: 1rem;
  }
  .contents a {
    color: var(--slate);
    text-decoration: none;
    line-height: 1.45;
    display: block;
  }
  .contents a:hover {
    color: var(--link-hover);
    text-decoration: underline;
  }
  .article-body {
    min-width: 0;
    max-width: 76ch;
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--slate);
    overflow-wrap: anywhere;
  }
  .article-body :global(h2) {
    font-size: clamp(1.75rem, 2.6vw, 2.15rem);
    font-weight: 600;
    line-height: 1.25;
    margin: 4rem 0 1.25rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-strong);
    color: var(--ink);
    letter-spacing: -0.04em;
    clear: both;
    scroll-margin-top: 110px;
  }
  .article-body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .article-body :global(h3) {
    font-size: 1.4rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 2.75rem 0 0.85rem;
    color: var(--ink);
    scroll-margin-top: 110px;
  }
  .article-body :global(h4) {
    font-family: var(--body);
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.5;
    letter-spacing: 0;
    color: var(--ink);
    margin: 2rem 0 0.5rem;
    scroll-margin-top: 110px;
  }
  .article-body :global(h2 + h3) {
    margin-top: 1.5rem;
  }
  .article-body :global(h3 + h4) {
    margin-top: 1.25rem;
  }
  .article-body :global(h4 + p) {
    margin-top: 0.5rem;
  }
  .article-body :global(p) {
    margin: 1.15rem 0;
  }
  .article-body :global(a) {
    color: var(--link-hover);
    text-underline-offset: 3px;
  }
  .article-body :global(a:hover) {
    color: var(--ink);
  }
  .article-body :global(strong) {
    color: var(--ink);
  }
  .article-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: 4px;
    margin: 1.8rem auto;
  }
  .article-body :global(img.left) {
    float: left;
    margin: 0.4rem 1.5rem 1rem 0;
  }
  .article-body :global(img.right) {
    float: right;
    margin: 0.4rem 0 1rem 1.5rem;
  }
  .article-body :global(img.w-50) {
    max-width: 50%;
  }
  .article-body :global(img.w-45) {
    max-width: 45%;
  }
  .article-body :global(pre) {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 5px;
    overflow-x: auto;
    font-size: 0.8rem;
    line-height: 1.65;
    margin: 1.8rem 0;
    overflow-wrap: normal;
  }
  .article-body :global(code) {
    font-size: 0.88em;
  }
  .article-body :global(:not(pre) > code) {
    background: var(--surface-muted);
    padding: 0.12em 0.3em;
    border-radius: 3px;
    color: var(--link-hover);
  }
  .article-body :global(blockquote) {
    margin: 1.5rem 0;
    border-left: 3px solid var(--line-strong);
    padding: 0.1rem 1.3rem;
    color: var(--slate);
  }
  .article-body :global(aside[class^='prompt-']) {
    background: var(--surface-muted);
    border-left: 3px solid var(--line-strong);
    padding: 0.3rem 1.25rem;
    margin: 1.8rem 0;
    border-radius: 0 5px 5px 0;
    clear: both;
    font-size: 1rem;
    line-height: 1.65;
  }
  .article-body :global(aside blockquote) {
    border: 0;
    margin: 0;
    padding: 0;
  }
  .article-body :global(aside.prompt-warning) {
    background: var(--warning-bg);
    border-color: var(--warning-line);
  }
  .article-body :global(aside.prompt-danger) {
    background: var(--danger-bg);
    border-color: var(--danger-line);
  }
  .article-body :global(aside.prompt-tip) {
    background: var(--success-bg);
    border-color: var(--success-line);
  }
  .article-body :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.95rem;
    margin: 1.75rem 0;
  }
  .article-body :global(th),
  .article-body :global(td) {
    padding: 0.65rem 0.9rem;
    border: 1px solid var(--line);
    text-align: left;
    min-width: 100px;
  }
  .article-body :global(th) {
    background: var(--surface-muted);
    color: var(--ink);
    font-weight: 600;
  }
  .article-body :global(ul),
  .article-body :global(ol) {
    padding-left: 1.4rem;
  }
  .article-body :global(li) {
    margin: 0.65rem 0;
    padding-left: 0.25rem;
  }
  .article-body :global(li::marker) {
    color: var(--blue);
    font-weight: 600;
  }
  .article-body :global(li > p) {
    margin: 0.4rem 0;
  }
  .article-end {
    border-top: 1px solid var(--line);
    padding-top: 2rem;
    margin-top: 3rem;
    clear: both;
  }
  .tags {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .tags a {
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .tags a:hover {
    background: var(--surface-muted);
  }
  @media (max-width: 900px) {
    .article-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .contents {
      position: static;
      max-height: none;
      padding: 1rem 1.25rem;
      background: var(--surface-muted);
      border-radius: 5px;
    }
    .contents ol {
      columns: 2;
    }
    .contents li {
      break-inside: avoid;
    }
    .article-hero {
      margin-bottom: 2rem;
    }
  }
  @media (max-width: 600px) {
    .contents ol {
      columns: 1;
    }
    .article-body {
      font-size: 1.0625rem;
    }
    .article-body :global(h2) {
      margin-top: 3rem;
      padding-top: 1.35rem;
    }
    .article-body :global(img.left),
    .article-body :global(img.right) {
      float: none;
      margin: 1.5rem auto;
      max-width: 100%;
    }
    .article-body :global(pre) {
      font-size: 0.73rem;
      padding: 1rem;
    }
    .byline {
      font-size: 0.85rem;
    }
    .article-header {
      padding-bottom: 1.8rem;
    }
  }
</style>
