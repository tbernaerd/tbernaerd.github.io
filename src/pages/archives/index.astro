---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getAllPosts } from '../../lib/posts';
const posts = await getAllPosts();
const years = [
  ...new Set(posts.map((post) => post.data.published.getUTCFullYear())),
];
---

<BaseLayout
  title="Article archive"
  description="Every Outer Join article on Produmex WMS, SAP Business One and software development."
>
  <section class="wrap section archive">
    <p class="section-note">The complete collection</p>
    <h1>Article archive.</h1>
    <p class="intro">Practical notes, kept for reference.</p>
    <div class="links">
      <a class="text-link" href="/insights/">
        Search articles
      </a>
      <a class="text-link" href="/tags/">
        Topics
      </a>
      <a class="text-link" href="/categories/">
        Categories
      </a>
      <a class="text-link" href="/feed.xml">
        RSS feed
      </a>
    </div>
    {years.map((year) => (
      <section class="year">
        <h2>{year}</h2>
        <ArticleList
          posts={posts.filter(
            (post) => post.data.published.getUTCFullYear() === year,
          )}
        />
      </section>
    ))}
  </section>
</BaseLayout>
<style>
  .archive {
    max-width: 1080px;
  }
  .archive h1 {
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    letter-spacing: -0.06em;
    line-height: 1.1;
    margin: 1.2rem 0;
  }
  .intro {
    color: var(--slate);
    font-size: 1.2rem;
  }
  .links {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin: 2rem 0 3.5rem;
  }
  .year {
    margin: 3rem 0;
  }
  .year > h2 {
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    color: var(--blue);
    margin: 0 0 1.3rem;
  }
</style>
