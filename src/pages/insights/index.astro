---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/ArticleList.astro';
import { getListedPosts } from '../../lib/posts';
const posts = await getListedPosts();
---

<BaseLayout
  title="Insights"
  description="Practical notes on Produmex WMS, SAP Business One and building useful software."
>
  <section class="wrap section insights">
    <p class="section-note">Notes from the work</p>
    <h1>
      Useful things,
      <br />
      <span>written down.</span>
    </h1>
    <p class="intro">
      Practical notes on Produmex WMS, SAP Business One, and the tools I use to
      build software.
    </p>
    <div class="browse">
      <a class="text-link" href="/archives/">
        All articles
      </a>
      <a class="text-link" href="/tags/">
        Browse topics
      </a>
      <a class="text-link" href="/feed.xml">
        Subscribe via RSS
      </a>
    </div>
    <form role="search" class="search" id="article-search">
      <label for="search-query">Search articles</label>
      <div class="search-controls">
        <input
          id="search-query"
          type="search"
          name="q"
          placeholder="Try licensing, SQL, or picking"
          autocomplete="off"
          aria-controls="search-results"
        />
        <button type="button" id="search-clear" hidden>
          Clear
        </button>
      </div>
      <p id="search-status" role="status" aria-live="polite">
        {posts.length} articles
      </p>
    </form>
    <div id="default-articles">
      <ArticleList posts={posts} />
    </div>
    <div id="search-results" hidden></div>
    <noscript>
      <p>
        Search needs JavaScript. Browse every article in the{' '}
        <a href="/archives/">archive</a>.
      </p>
    </noscript>
  </section>
</BaseLayout>
<script>
  type SearchPost = {
    title: string;
    url: string;
    content: string;
    description: string;
    tags: string[];
    categories: string[];
    date: string;
  };
  const form = document.querySelector<HTMLFormElement>('#article-search')!;
  const input = document.querySelector<HTMLInputElement>('#search-query')!;
  const clear = document.querySelector<HTMLButtonElement>('#search-clear')!;
  const status = document.querySelector<HTMLElement>('#search-status')!;
  const defaults = document.querySelector<HTMLElement>('#default-articles')!;
  const results = document.querySelector<HTMLElement>('#search-results')!;
  const initialStatus = status.textContent;
  let index: Promise<SearchPost[]> | undefined;
  let request = 0;
  async function search() {
    const current = ++request;
    const query = input.value.trim().toLocaleLowerCase();
    clear.hidden = !input.value;
    if (!query) {
      defaults.hidden = false;
      results.hidden = true;
      results.replaceChildren();
      status.textContent = initialStatus;
      return;
    }
    defaults.hidden = true;
    results.hidden = false;
    status.textContent = 'Searching…';
    try {
      index ??= fetch('/assets/js/data/search.json').then((response) => {
        if (!response.ok) throw new Error('Search unavailable');
        return response.json();
      });
      const articles = await index;
      if (current !== request) return;
      const words = query.split(/\s+/);
      const matches = articles.filter((post) => {
        const text = [
          post.title,
          post.description,
          post.content,
          ...post.tags,
          ...post.categories,
        ]
          .join(' ')
          .toLocaleLowerCase();
        return words.every((word) => text.includes(word));
      });
      results.replaceChildren();
      status.textContent = `${matches.length} ${matches.length === 1 ? 'article' : 'articles'} found`;
      for (const post of matches) {
        const article = document.createElement('article');
        article.className = 'search-result';
        const date = document.createElement('time');
        date.dateTime = post.date;
        date.textContent = new Intl.DateTimeFormat('en-GB', {
          day: 'numeric',
          month: 'long',
          year: 'numeric',
          timeZone: 'UTC',
        }).format(new Date(post.date));
        const heading = document.createElement('h2');
        const link = document.createElement('a');
        link.href = post.url;
        link.textContent = post.title;
        heading.append(link);
        const description = document.createElement('p');
        description.textContent = post.description;
        article.append(date, heading, description);
        results.append(article);
      }
      if (!matches.length) {
        const message = document.createElement('p');
        message.textContent =
          'No articles match your search. Try a broader term, or clear the search.';
        results.append(message);
      }
    } catch {
      if (current !== request) return;
      index = undefined;
      results.replaceChildren();
      status.textContent =
        'Search is unavailable. Browse all articles in the archive above.';
    }
  }
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    void search();
  });
  input.addEventListener('input', () => void search());
  clear.addEventListener('click', () => {
    input.value = '';
    void search();
    input.focus();
  });
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      input.value = '';
      void search();
    }
  });
</script>
<style>
  .insights {
    max-width: 1080px;
  }
  .insights h1 {
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.065em;
    margin: 1.3rem 0;
  }
  .insights h1 span {
    color: #547a98;
  }
  .intro {
    max-width: 620px;
    font-size: 1.2rem;
    color: #516678;
  }
  .browse {
    display: flex;
    gap: 1.8rem;
    flex-wrap: wrap;
    margin: 2rem 0 3.5rem;
  }
  .search {
    max-width: 680px;
    margin: 0 0 1.5rem;
  }
  .search label {
    font-weight: 600;
    display: block;
    margin-bottom: 0.6rem;
  }
  .search-controls {
    display: flex;
    gap: 0.65rem;
  }
  .search input {
    width: 100%;
    min-width: 0;
    border: 1px solid #afc1cf;
    padding: 0.85rem 1rem;
    border-radius: 4px;
    background: white;
    font: inherit;
    color: #193347;
  }
  .search button {
    border: 1px solid #afc1cf;
    border-radius: 4px;
    background: #e9f0f5;
    padding: 0 1rem;
    font: inherit;
    cursor: pointer;
  }
  .search input:focus-visible,
  .search button:focus-visible {
    outline: 3px solid #547a98;
    outline-offset: 3px;
  }
  #search-status {
    font-size: 0.9rem;
    color: #516678;
    margin: 0.6rem 0;
  }
  #search-results :global(.search-result) {
    padding: 2rem 0;
    border-top: 1px solid #c8d5df;
  }
  #search-results :global(h2) {
    font-size: 1.6rem;
    margin: 0.5rem 0;
  }
  #search-results :global(a) {
    color: #193347;
    text-decoration: none;
  }
  #search-results :global(a:hover) {
    text-decoration: underline;
  }
  #search-results :global(time) {
    font-size: 0.9rem;
    color: #516678;
  }
  #search-results :global(p) {
    color: #516678;
  }
</style>
