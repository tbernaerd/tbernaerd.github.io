---
import { formatDate, postUrl, readingMinutes, type Post } from '../lib/posts';
interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

<div class="article-list">
  {posts.map((post) => (
    <article class="article-row">
      <div class="article-meta">
        <time datetime={post.data.published.toISOString()}>
          {formatDate(post.data.published)}
        </time>
        <span>
          {post.data.categories[0]} · {readingMinutes(post)} min read
        </span>
      </div>
      <div>
        <h2>
          <a href={postUrl(post)}>
            {post.data.title}
            <span aria-hidden="true"> ↗</span>
          </a>
        </h2>
        <p>{post.data.description}</p>
      </div>
    </article>
  ))}
</div>
<style>
  .article-list {
    border-top: 1px solid #c8d5df;
  }
  .article-row {
    display: grid;
    grid-template-columns: 180px minmax(0, 1fr);
    gap: 2rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid #c8d5df;
  }
  .article-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: #516678;
    font-size: 0.9rem;
    padding-top: 0.25rem;
  }
  .article-meta span {
    font-size: 0.8rem;
  }
  .article-row h2 {
    font-size: clamp(1.25rem, 2.3vw, 1.65rem);
    line-height: 1.35;
    margin: 0 0 0.7rem;
    letter-spacing: -0.04em;
  }
  .article-row a {
    color: inherit;
    text-decoration: none;
  }
  .article-row a:hover {
    color: #356a91;
  }
  .article-row a span {
    color: #6689a3;
    display: inline-block;
    font-size: 1.1rem;
  }
  .article-row p {
    max-width: 66ch;
    color: #516678;
    margin: 0;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .article-row {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      padding: 1.75rem 0;
    }
    .article-meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
    }
  }
</style>
