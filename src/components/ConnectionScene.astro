---
import Icon from './Icon.astro';
---

<div
  class="connection-scene"
  aria-label="SAP Business One and Produmex connected to a tailored web application"
>
  <div class="scene-halo"></div>
  <p class="scene-caption">The systems you know. A better way to work.</p>
  <svg
    class="scene-lines"
    viewBox="0 0 500 466"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path
      class="wire"
      d="M100 157v36q0 22 22 22h107q21 0 21 21v28M400 157v36q0 22-22 22H271q-21 0-21 21v28"
    />
    <path
      class="wire moving"
      d="M100 157v36q0 22 22 22h107q21 0 21 21v28M400 157v36q0 22-22 22H271q-21 0-21 21v28"
    />
    <circle cx="250" cy="215" r="4" fill="#4a6481" />
  </svg>
  <div class="system-node sap">
    <span class="node-mark">SAP</span>
    <div>
      <strong>SAP Business One</strong>
      <small>Your business foundation</small>
    </div>
  </div>
  <div class="system-node pmx">
    <span class="node-mark">
      <Icon name="layers" />
    </span>
    <div>
      <strong>Produmex WMS</strong>
      <small>Your warehouse operations</small>
    </div>
  </div>
  <div class="application-node">
    <div class="app-node-title">
      <Icon name="grid" />
      <div>
        <strong>Built around your workflow</strong>
        <small>Connected web applications</small>
      </div>
    </div>
    <div class="app-node-row">
      Quality control & batch release <Icon name="check" />
    </div>
    <div class="app-node-row">
      The functionality you’re missing <Icon name="check" />
    </div>
  </div>
  <p class="scene-footnote">One connected workflow. Built to fit.</p>
</div>
