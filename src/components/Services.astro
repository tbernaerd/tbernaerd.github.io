---
import Icon from './Icon.astro';
const services = [
  {
    icon: 'flask',
    title: 'OuterForge Quality',
    description:
      'Ready-made QC software on OuterForge. Manage specifications, samples, supplier certificates and batch release, connected to SAP Business One and Produmex.',
    url: '/solutions/quality-control/',
  },
  {
    icon: 'consult',
    title: 'Logistics consulting',
    description:
      'Hands-on help with technical issues, workflow decisions and focused improvements to the systems you already run.',
    url: '/solutions/consulting/',
  },
  {
    icon: 'code',
    title: 'Bespoke applications',
    description:
      'Web applications built on OuterForge for the work your ERP leaves uncovered. Existing connections, users and background jobs give us a foundation to build on.',
    url: '/solutions/bespoke-applications/',
  },
];
---

<div class="service-list studio-services">
  {services.map((service) => (
    <article class="service">
      <div class="service-icon">
        <Icon name={service.icon} />
      </div>
      <div>
        <h3>{service.title}</h3>
        <p>{service.description}</p>
        <a class="text-link" href={service.url}>
          Find out more{' '}
          <span class="sr-only">about {service.title.toLowerCase()}</span>
          <Icon />
        </a>
      </div>
    </article>
  ))}
</div>

<style>
  .studio-services {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
  }
  @media (max-width: 800px) {
    .studio-services {
      grid-template-columns: 1fr;
      gap: 35px;
    }
  }
</style>
