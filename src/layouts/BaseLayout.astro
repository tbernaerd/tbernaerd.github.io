---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/theme.css';
import themeScript from '../scripts/theme.js?raw';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'OuterForge Quality software, bespoke web applications and logistics consulting for SAP Business One and Produmex WMS. Outer Join, the independent studio of Tom Bernaerd.',
  image = '/social/outerjoin.png',
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} | Outer Join`
  : 'Outer Join | Connected software. Built around you.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline set:html={themeScript}></script>
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Outer Join insights"
      href="/feed.xml"
    />
    <link
      rel="preload"
      href="/fonts/sora.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-sans-3.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {!Astro.url.pathname.startsWith('/posts/') && (
      <meta property="og:type" content="website" />
    )}
    <meta property="og:site_name" content="Outer Join" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <noscript>
      <style>
        .mobile-nav {
          display: flex;
          flex-wrap: wrap;
          gap: 18px;
          padding: 12px 24px;
        }
        .menu-toggle {
          display: none;
        }
        @media (min-width: 801px) {
          .mobile-nav {
            display: none;
          }
        }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Retire only the previous Chirpy worker. New visitors never install one.
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker
          .getRegistrations()
          .then((registrations) => {
            for (const registration of registrations) {
              const worker =
                registration.active ??
                registration.waiting ??
                registration.installing;
              if (
                worker &&
                new URL(worker.scriptURL).origin === location.origin &&
                new URL(worker.scriptURL).pathname === '/sw.min.js'
              ) {
                registration.update().catch(() => {});
              }
            }
          })
          .catch(() => {});
      }
    </script>
  </body>
</html>
